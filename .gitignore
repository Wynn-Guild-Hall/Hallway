# Hugo build artefacts
public/
resources/
.hugo_build.lock

# Hugo themes are pulled as git submodules; the checkout goes here.
# The submodule *entry* is committed via .gitmodules, but the working-tree
# contents are ignored so a `git submodule update --init` reproduces them.
themes/*/

# Node (Playwright test tooling)
node_modules/
tests/node_modules/
tests/playwright-report/
tests/test-results/

# Env / secrets
.env
.env.*
!.env.example

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
.history/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local, per-machine, and ephemeral scratch
.claude
.local
.ephemeral
